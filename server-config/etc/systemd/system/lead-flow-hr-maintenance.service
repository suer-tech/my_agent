[Unit]
Description=HR lead backup and bounded terminal-source retention
ConditionPathExists=/opt/iva/data/lead-flow/hr-research.sqlite3
[Service]
Type=oneshot
User=iva
Group=iva
WorkingDirectory=/opt/lead-flow
Environment=PYTHONPATH=/opt/lead-flow
ExecStart=/opt/iva/.venv/bin/python /opt/lead-flow/hr_maintenance.py
UMask=0077
Nice=15
