[Unit]
Description=HR first real read and reviewed letter probe (no CRM or SMTP)
After=network-online.target iva-browser-coordinator.service iva-research-fetch.service
[Service]
Type=oneshot
User=iva
Group=iva
WorkingDirectory=/opt/lead-flow
Environment=PYTHONPATH=/opt/iva:/opt/lead-flow
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/iva
Environment=CODEX_HOME=/home/iva/.codex
Environment=PATH=/opt/iva/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=FINANCE_CODEX_EXE=/usr/local/bin/iva-codex
ExecStart=/opt/iva/.venv/bin/python /opt/lead-flow/hr_campaign.py --config /opt/iva/data/hr-release-20261027/probe/config.json
TimeoutStartSec=infinity
UMask=0077
Nice=10
CPUQuota=35%
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=128M
PrivateTmp=yes
