
# Private local server snapshot (2026-10-28)
/.server-backups/
/.server-import-*/
/.server-state-import-*/
/.local-before-server-sync-*/
/.task-tools/
/.local-keys/
/server-config/
/iva/.env
/iva/.venv/
/iva/data/
/lead-flow/data/
/lead-flow/acceptance-venv/
**/__pycache__/

# Source import: never publish working data, account sessions or credentials.
/reports/
/iva/vault/
**/.env
**/.env.local
**/.env.production
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.pyc
**/*.log
**/*.jsonl
**/node_modules/
**/.pytest_cache/
**/.output/
**/.eve/
**/.iva-build/
**/venv/
!/.gitignore

