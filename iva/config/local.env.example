# Локальный Windows-адаптер. Реальный .env создаёт Configure-Local.ps1.
TELEGRAM_BOT_TOKEN=
FINANCE_ALLOWED_USER_ID=412850740
FINANCE_CODEX_TIMEOUT=150
FINANCE_REMINDER_HOUR=9
# Срок предупреждения до платежа, НЕ интервал опроса (он остаётся 60 секунд).
FINANCE_DEFAULT_LEAD_DAYS=1
# auto: на голос — текст + голос; on: все ответы озвучивать; off: текстовые ответы.
FINANCE_VOICE_MODE=auto
# Модель по умолчанию читается из пользовательского config.toml (без ключей).
# FINANCE_CODEX_MODEL=gpt-6.1-sol
# FINANCE_CODEX_EXE=C:\path\to\codex.exe
