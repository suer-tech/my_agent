[Unit]
Description=Compact old research intermediates while preserving evidence
After=iva-browser-coordinator.service

[Service]
Type=oneshot
User=iva
Group=iva
WorkingDirectory=/opt/iva
Environment=HOME=/home/iva
ExecStart=/opt/iva/.venv/bin/python -m iva_integration.demand_storage
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=256M
TimeoutStartSec=180

