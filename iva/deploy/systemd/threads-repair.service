[Unit]
Description=Bounded Codex diagnosis and isolated testing for Threads
After=iva-browser-coordinator.service iva-vpn.service

[Service]
Type=oneshot
User=iva
Group=iva
WorkingDirectory=/opt/iva
Environment=HOME=/home/iva
Environment=FINANCE_CODEX_EXE=/usr/local/bin/iva-codex
ExecStart=/opt/iva/.venv/bin/python -m iva_integration.threads_repair
UMask=0077
TimeoutStartSec=420
MemoryHigh=256M
MemoryMax=384M
TasksMax=96
Nice=15
IOSchedulingClass=idle

